container RegionalUnits : Using = "Geography;" 
{
	container impl
	{
		container NUTS 
		: StorageName = "%IGOR_DataDir%/Regions/NUTS_RG_01M_2021_3035.gpkg"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "True"
		, SyncMode = "AllTables"
		{
			unit<uint32> NUTS_RG_01M_2021_3035_gpkg
			{
				attribute<LambertEA_base> geometry_base (poly) := geometry[LambertEA_base];
			}
		}
		
		container LAU
		: StorageName = "%IGOR_DataDir%/Regions/LAU_RG_01M_2021_3035.gpkg"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "True"
		, SyncMode = "AllTables"
		, DialogData = "LambertEA"
		{
			unit<uint32> LAU_RG_01M_2021_3035_gpkg
			{
				attribute<LambertEA> geometry (poly); // explicit: without this gdal.vect syncs the layer as arc and (poly) consumers get a deprecation warning
			}
		}
		
		container LAU_overrides_2022
		: StorageName = "%IGOR_DataDir%/Regions/LAU_RG_01M_2022_3035_overrides.gpkg"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "True"
		, SyncMode = "AllTables"
		, DialogData = "LambertEA"
		{
			unit<uint32> lau_rg_01m_2022_3035_overrides
			{
				attribute<LambertEA> geometry (poly);
			}
		}
		
		unit<uint32> Country 
		: StorageName = "%IGOR_DataDir%/Regions/CNTR_RG_01M_2020_3035.shp"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "true"
		{
			attribute<LambertEA> geometry (poly);
			attribute<bool>      IsEU            := EU_STAT == 'T'; 
			attribute<bool>      IsEFTA          := EFTA_STAT == 'T'; 
			attribute<bool>      IsCC            := CC_STAT == 'T'; 
			attribute<bool>      IsTerritory       := strcount(SVRG_UN, 'Territory') > 0; 
			unit<uint32> subset := select_with_attr_by_cond(.,(ModelParameters/Use_Country_selection ? name_engl == /ModelParameters/StudyArea : IsEU || IsEFTA))
			{
				attribute<LambertEA>    geometry_BB (poly, BoundingBox) := points2polygon(BoundingBox/point_set/point, BoundingBox/point_set/sequence_rel, BoundingBox/point_set/ordinal);
				
				unit<uint32> BoundingBox : nrofrows = 1
				{
					parameter<LambertEA> bottom_left  := first(lower_bound(geometry));
					parameter<LambertEA> top_right    := first(upper_bound(geometry));
					parameter<LambertEA> top_left     := point_xy(get_x(bottom_left),get_y(top_right), LambertEA);
					parameter<LambertEA> bottom_right := point_xy(get_x(top_right),get_y(bottom_left), LambertEA);
					
					unit<uint32> point_set    : nrofrows = 5
					{
						attribute<LambertEA> point        := union_data(., top_left, top_right, bottom_right, bottom_left, top_left);
						attribute<..>        sequence_rel := const(0, .);
						attribute<.>         ordinal      := id(.);
					}
				}
			}
		}
		
		unit<uint32> Country_Split := geos_split_union_polygon(Country/geometry, id(Country))
		{
			attribute<LambertEA> geometry_lea (poly) := geometry[LambertEA];
			attribute<LambertEA> centroid            := centroid_or_mid(geometry_lea);
			attribute<bool>      IsEU                := Country/IsEU[part_rel];
			attribute<bool>      IsEFTA              := Country/IsEFTA[part_rel];
			attribute<bool>      IsTerritory         := Country/IsTerritory[part_rel];
			attribute<bool>      IsWithinStudyArea   := IsDefined(point_in_polygon(centroid, geography/selection_polygon/geometry[LambertEA]));
			attribute<string>    name                := Country/name_engl[part_rel];
		}

		unit<uint32> EUplus         := select_with_attr_by_cond(Country, (Country/IsEU || Country/IsEFTA) && !Country/IsTerritory);
		
		unit<uint32> Continental_EU_undissolved := select_with_org_rel((Country_Split/IsEU || Country_Split/IsEFTA) && !Country_Split/IsTerritory && Country_Split/IsWithinStudyArea)
		{
			attribute<LambertEA>      geometry        (poly) := Country_Split/geometry_lea[org_rel];
			attribute<string>         name                   := Country_Split/name[org_rel];
			attribute<Continental_EU> Continental_EU_rel     := rlookup(name, Continental_EU/Values);
			
		}
		
		unit<uint8> Continental_EU := unique_uint8(Continental_EU_undissolved/name)
		{
			attribute<LambertEA>       geometry (poly) := geos_union_polygon(Continental_EU_undissolved/geometry, Continental_EU_undissolved/Continental_EU_rel);
			attribute<string>          name            := Values;
			attribute<string>          Label           := Values;
			attribute<Country/subset>  Country_rel     := rlookup(name, Country/subset/name_engl);
			attribute<string>          country_id      := Country/subset/CNTR_ID[Country_rel];
		}
	}
	
	/*	CRISP #126 (https://github.com/ObjectVision/CRISP/issues/126):
		de lopende hypothese daar is dat poly2grid() de LINKERBOVENHOEK van een gridcel toetst en het
		GHSL-team het CELMIDDEN, en dat een halve-celverschuiving onze delineatie gelijk zou trekken.
		Deze container meet dat na op de EU-landsgrenzen in het 1km-grid, en weerlegt die hypothese:

			poly2grid()  ==  point_in_polygon(celmidden)   -> 0 verschillende cellen van 4.592.492
			poly2grid()  vs  point_in_polygon(linkerbovenhoek) -> 58.695 verschillende cellen

		poly2grid() toetst dus al het celmidden, precies de GHSL-conventie; de voorgestelde halve-cel-
		verschuiving zou het verschil juist INTRODUCEREN (58.731 cellen, zie counts/nr_p2g_vs_shifted).
		Dat cell_topleft op ronde kilometers ligt (2.636.000 ...) en cell_centre op ...500, bevestigt
		welk punt welk is.

		De verschuiving zelf staat hieronder wel uitgewerkt, want dat is de manier om poly2grid een
		ander toetspunt te geven: verschuif niet het grid maar de POLYGONEN, over -0.5 * gridcelmaat.
		Zo blijft poly2grid bruikbaar (getiled, snel) in plaats van een point_in_polygon over alle cellen.
	*/
	container Countries : Descr = "CRISP #126: welk punt van een gridcel toetst poly2grid, en wat doet een halve-celverschuiving?"
	{
		unit<uint32> region := impl/Country/subset;
		unit<ipoint> domain := Geography/impl/domain_1000m;

		attribute<LambertEA> cell_topleft (domain) := id(domain)[LambertEA], Descr = "hoekpunt van de cel: ronde kilometers";
		attribute<LambertEA> cell_centre  (domain) := domain/geometry,       Descr = "hoekpunt + een halve cel, dus ...500";

		attribute<region> per_domain         (domain) := poly2grid(region/geometry, domain),          Descr = "zoals overal in het model";
		attribute<region> per_domain_centre  (domain) := point_in_polygon(cell_centre,  region/geometry), Descr = "referentie: celmidden getoetst";
		attribute<region> per_domain_topleft (domain) := point_in_polygon(cell_topleft, region/geometry), Descr = "referentie: linkerbovenhoek getoetst";

		//	het voorstel uit issue #126: de polygonen een halve cel verschuiven i.p.v. het grid
		parameter<float64>   cell_size_x := get_x(getprojectionfactor(domain)), Descr = "gridcelmaat in x-richting: +1000 m";
		parameter<float64>   cell_size_y := get_y(getprojectionfactor(domain)), Descr = "gridcelmaat in y-richting: -1000 m, want het grid loopt naar beneden";
		parameter<LambertEA> half_cell   := point_xy(0.5d * cell_size_x, 0.5d * cell_size_y, LambertEA), Descr = "xy(500; -500)";

		unit<uint32> point_set := sequence2points(region/geometry)
		{
			attribute<LambertEA> point_shifted := point - half_cell;
		}
		attribute<LambertEA> geometry_shifted (poly, region) := points2polygon(point_set/point_shifted, point_set/sequence_rel, point_set/ordinal);
		attribute<region>     per_domain_shifted     (domain) := poly2grid(geometry_shifted, domain), Descr = "poly2grid op een halve cel verschoven polygonen";

		//	nul-veilige codering voor het vergelijken: 0 = in geen enkel land, anders landnummer + 1
		attribute<uint32> code_p2g     (domain) := IsDefined(per_domain)         ? uint32(per_domain)         + 1 : 0;
		attribute<uint32> code_centre  (domain) := IsDefined(per_domain_centre)  ? uint32(per_domain_centre)  + 1 : 0;
		attribute<uint32> code_topleft (domain) := IsDefined(per_domain_topleft) ? uint32(per_domain_topleft) + 1 : 0;
		attribute<uint32> code_shifted (domain) := IsDefined(per_domain_shifted) ? uint32(per_domain_shifted) + 1 : 0;

		unit<uint8> diff_class : nrofrows = 4
		{
			attribute<string> Label      : ['gelijk', 'cel valt weg door de verschuiving', 'cel komt erbij door de verschuiving', 'cel gaat naar een ander land'];
			attribute<uint32> BrushColor : [rgb(235,235,235), rgb(215,45,45), rgb(45,110,215), rgb(245,175,40)];
		}

		attribute<diff_class> diff_shifted (domain) := code_p2g == code_shifted
			? 0[diff_class]
			: (code_shifted == 0 ? 1[diff_class] : (code_p2g == 0 ? 2[diff_class] : 3[diff_class]))
		,	Descr = "wat de voorgestelde halve-celverschuiving met de landdelineatie zou doen";

		container counts : Descr = "de tellingen die in issue #126 gerapporteerd zijn"
		{
			parameter<uint32> nr_cells_in_a_country := sum(uint32(code_p2g <> 0));
			parameter<uint32> nr_p2g_vs_centre      := sum(uint32(code_p2g <> code_centre)),  Descr = "0: poly2grid toetst het celmidden";
			parameter<uint32> nr_p2g_vs_topleft     := sum(uint32(code_p2g <> code_topleft)), Descr = "> 0: poly2grid toetst dus NIET de linkerbovenhoek";
			parameter<uint32> nr_p2g_vs_shifted     := sum(uint32(code_p2g <> code_shifted)), Descr = "wat de verschuiving zou kosten";
			parameter<uint32> nr_shift_loses        := sum(uint32(diff_shifted == 1[diff_class]));
			parameter<uint32> nr_shift_gains        := sum(uint32(diff_shifted == 2[diff_class]));
			parameter<uint32> nr_shift_reassigns    := sum(uint32(diff_shifted == 3[diff_class]));
		}
	}
	
	unit<uint32> LAU_org := select_with_attr_by_cond(impl/LAU/LAU_RG_01M_2021_3035_gpkg, IsDefined(impl/LAU/LAU_RG_01M_2021_3035_gpkg/geometry))
	{
		attribute<.>         per_domain (domain) := poly2grid(geometry, domain);
		attribute<float32>   count_cel_in_r      := float32(pcount(per_domain));
		attribute<bool>      IsStudyArea         := IsDefined(point_in_polygon(centroid_or_mid(geometry), Country/subset/geometry_BB[LambertEA]));
		attribute<bool>      IsContinentalEU     := IsDefined(point_in_polygon(centroid_or_mid(geometry), impl/Continental_EU/geometry));
		attribute<bool>      Drop                := GISCO_ID = 'DE_12073505' || GISCO_ID = 'FI_099' || GISCO_ID = 'NL_GM0788';
		attribute<impl/LAU_overrides_2022/lau_rg_01m_2022_3035_overrides> overrides_id := rlookup(GISCO_ID, impl/LAU_overrides_2022/lau_rg_01m_2022_3035_overrides/GISCO_ID);
		attribute<bool>      use_override        := IsDefined(overrides_id);

		//	geom_override takes the 2022 override geometry where one exists. Deliberately NOT written as
		//	'use_override ? override_geometry : geometry': the ?: operator yields ValueComposition 'arc' for
		//	polygon operands, which GeoDms 20.x reports as deprecated (and a future major version will refuse).
		//	A lookup into the union of both geometry sets keeps the 'poly' composition intact.
		unit<uint32> geom_source := union_unit(., impl/LAU_overrides_2022/lau_rg_01m_2022_3035_overrides)
		{
			attribute<LambertEA> geometry (poly) := union_data(., ../geometry, impl/LAU_overrides_2022/lau_rg_01m_2022_3035_overrides/geometry);
		}
		attribute<geom_source> geom_source_rel    := use_override ? value(#. + uint32(overrides_id), geom_source) : value(id(.), geom_source);
		attribute<LambertEA>   geom_override (poly):= geom_source/geometry[geom_source_rel];
		
		
		unit<uint32> StudyArea := =ModelParameters/Use_Country_selection ? 'select_with_org_rel(IsStudyArea && IsContinentalEU && !Drop)' : 'select_with_org_rel(IsContinentalEU && !Drop)'
		{
			attribute<LambertEA>   geometry                                 (poly) := ../geom_override[org_rel];
			attribute<.>           per_domain_100m    (Geography/impl/domain_100m) := poly2grid(geometry, Geography/impl/domain_100m);
			attribute<.>           per_domain_1000m  (Geography/impl/domain_1000m) := poly2grid(geometry, Geography/impl/domain_1000m);
			attribute<string>      GISCO_ID                                        := ../GISCO_ID[org_rel];
			attribute<uint32>      as_pl_count                                     := pcount(SourceData/Population/AGEGROUP5_SEX_perLAU/result/LAU_rel);
			attribute<float32>     pop_as_pl                                       := sum(/SourceData/Population/AGEGROUP5_SEX_perLAU/result/Pop, /SourceData/Population/AGEGROUP5_SEX_perLAU/result/LAU_rel);
			
			attribute<NUTS3>       NUTS3_rel                                       := point_in_polygon(centroid_or_mid(geometry), NUTS3/geometry);
			
			unit<uint32> no_LAU_rel:= select_with_org_rel(as_pl_count < 1 && strcount(StudyArea/GISCO_ID, 'CH') = 0) 
			{
				attribute<string> GISCO_ID := StudyArea/GISCO_ID[org_rel];
				
				unit<uint32> uniques := unique(GISCO_ID);
			}
		}
	}
	
	unit<uint32> LAU     := LAU_org/StudyArea;
	
	unit<uint32> NUTS3   := select_with_org_rel(impl/NUTS/NUTS_RG_01M_2021_3035_gpkg/LEVL_CODE == 3w)
	{
		attribute<LambertEA>      geometry (poly) := org_rel -> geometry_base[LambertEA];
	}
	
	unit<uint32> Country := select_with_attr_by_cond(impl/NUTS/NUTS_RG_01M_2021_3035_gpkg, impl/NUTS/NUTS_RG_01M_2021_3035_gpkg/LEVL_CODE == 0w)
	{
		attribute<LambertEA> geometry_lea  (poly) := geometry_base[LambertEA];
		attribute<bool>      IsEU                 := const(true,.); 

		unit<uint32> subset := select_with_org_rel(ModelParameters/Use_Country_selection ? NUTS_NAME == /ModelParameters/StudyArea : IsEU)
		{
			attribute<LambertEA_base>    geometry_base              (poly) := Country/geometry_base[org_rel];
			attribute<LambertEA_base>    geometry_BB   (poly, BoundingBox) := points2polygon(BoundingBox/point_set/point, BoundingBox/point_set/sequence_rel, BoundingBox/point_set/ordinal);
			
			unit<uint32> BoundingBox : nrofrows = 1
			{
				parameter<LambertEA_base> bottom_left  := first(lower_bound(geometry_base));
				parameter<LambertEA_base> top_right    := first(upper_bound(geometry_base));
				parameter<LambertEA_base> top_left     := point_xy(get_x(bottom_left),get_y(top_right), LambertEA_base);
				parameter<LambertEA_base> bottom_right := point_xy(get_x(top_right),get_y(bottom_left), LambertEA_base);
				
				unit<uint32> point_set    : nrofrows = 5
				{
					attribute<LambertEA_base> point        := union_data(., top_left, top_right, bottom_right, bottom_left, top_left);
					attribute<..>        sequence_rel := const(0, .);
					attribute<.>         ordinal      := id(.);
				}
			}
		}
	}
	
	
	
	// unit<uint32> CountryTable:= range(uint32, 0, NrN0Zones)
